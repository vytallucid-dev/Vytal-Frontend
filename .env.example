# Copy to .env and fill in. All NEXT_PUBLIC_* vars are exposed to the browser.

# Backend API URL — the InvestIQ/Vytal API this frontend reads from.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── Supabase (client-side auth) ────────────────────────────────────────────
# Both are PUBLIC, browser-safe values. Supabase Dashboard → Project Settings → API.
#   NEXT_PUBLIC_SUPABASE_URL       Project URL (e.g. https://<ref>.supabase.co)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  the "anon public" / publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
